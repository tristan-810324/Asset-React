# Backend API address, including /api/v1. This value is built into the public website,
# so never put a password or secret in a VITE_ variable.
# Local development does not need it: Vite forwards /api/v1 to http://localhost:5000.
# On Vercel, set it in the project's Environment Variables and redeploy after changing it.
VITE_API_BASE_URL=https://YOUR-BACKEND.vercel.app/api/v1
