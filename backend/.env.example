NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/dyci_gso
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# On Vercel these values go in the project's Environment Variables, not in a file:
# - DATABASE_URL: the Neon pooled connection string (the host contains -pooler).
# - FRONTEND_ORIGIN: the exact frontend address, such as https://your-app.vercel.app.
#   Separate several addresses with commas.
# - Do not set PORT.

# Needed for first-login email verification and password-reset OTP email.
# For Gmail, SMTP_PASS must be a 16-character Google App Password,
# not the normal Gmail account password. Keep all four empty only when
# testing with already-verified accounts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=

# ============================================================================
# PAYMONGO TEST KEYS (Loss & Damage Cases payments) - PUT YOUR KEYS HERE
# ============================================================================
# Test mode only. No real money is charged. Leave both empty until you have
# them: GSO can still review cases and choose No charge or For repair, but
# "Payment required" waits for the keys.
#
# 1) PAYMONGO_SECRET_KEY = your TEST secret key.
#    PayMongo Dashboard > switch on Test mode > Developers > API Keys >
#    copy the Secret key. It starts with sk_test_
#    Do NOT paste the public key (pk_test_...) or a live key (sk_live_...):
#    the backend refuses to start with those.
PAYMONGO_SECRET_KEY=
#
# 2) PAYMONGO_WEBHOOK_SECRET = the secret of your TEST webhook.
#    PayMongo Dashboard (Test mode) > Developers > Webhooks > Add endpoint
#      URL:    https://YOUR-PUBLIC-BACKEND/api/v1/loss-damage/webhooks/paymongo
#      Event:  link.payment.paid
#    After saving, PayMongo shows the endpoint's secret key (whsk_...).
#    Paste it here. PayMongo cannot reach localhost, so for local testing use
#    an HTTPS tunnel URL (or your Vercel staging backend URL) as YOUR-PUBLIC-BACKEND.
PAYMONGO_WEBHOOK_SECRET=
#
# On Vercel, add the same two names in the BACKEND project's
# Environment Variables instead of this file. Never put them in the frontend
# or in a VITE_ variable.
