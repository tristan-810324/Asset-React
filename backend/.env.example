NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/dyci_gso
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Needed for first-login email verification and password-reset OTP email.
# For Gmail, SMTP_PASS must be a 16-character Google App Password,
# not the normal Gmail account password. Keep all four empty only when
# testing with already-verified accounts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=
